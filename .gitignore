# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
# *.[oa]
# *~

.DS_Store
*/.DS_Store
i3/i3blocks-contrib
i3/i3blocks-contrib/*
nvim/plugged
nvim/plugged/*
nvim/autoload
nvim/autoload/*
nvim/.netrwhist
zsh/.zcomp*
zsh/.zsh_history
zsh/.zsh_sessions*
zsh/.p10k.zsh
zsh/custom/plugins
zsh/custom/work.zsh-theme
nvim/lazy-lock.json
nvim/lazyvim.json
